---
// Sticky top nav. Glassy backdrop-blur over the gradient bg.
---
<header class="sticky top-0 z-50 backdrop-blur-xl bg-[rgba(21,8,43,.4)] border-b border-white/10">
  <div class="max-w-[1320px] mx-auto px-7 py-4 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3 font-display text-2xl no-underline">
      <!-- App icon: same asset as the favicon. Slight -6° tilt + soft acid
           glow ties it back to the page palette without re-coloring the art. -->
      <img
        src="/icon-512.png"
        alt="Streamoji"
        width="40"
        height="40"
        class="w-10 h-10 rounded-xl -rotate-6"
        style="box-shadow: 0 8px 30px rgba(212, 255, 58, .35);"
      />
      <span class="text-white">STREAM</span><span class="text-acid">OJI</span>
    </a>

    <nav class="hidden md:flex gap-1.5 items-center">
      <a href="#stickers"  class="nav-pill">Stickers</a>
      <a href="#how"       class="nav-pill">How</a>
      <a href="#download"  class="nav-pill nav-pill--cta">Get it ↗</a>
    </nav>
  </div>
</header>

<style>
  .nav-pill {
    padding: 10px 16px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, .08);
    color: white;
    text-decoration: none;
    font-weight: 700;
    font-size: 13px;
    transition: background .15s;
  }
  .nav-pill:hover { background: rgba(255, 255, 255, .16); }
  .nav-pill--cta { background: var(--color-acid); color: var(--color-ink); }
  .nav-pill--cta:hover { background: white; }
</style>
