---
// Three-step section: Pick → Pack → Send. Each step has a header + a fake
// in-app "screen" showing what that step looks like.
---
<section class="block" id="how">
  <div class="max-w-[1320px] mx-auto px-7 py-[100px]">
    <div class="mb-[50px] max-w-[800px] text-center mx-auto">
      <span class="head-eye">◆ How it works</span>
      <h2 class="section-title">
        <span class="font-shade text-hot">3 STEPS</span><br />
        and you're <span class="text-acid">SENDING.</span>
      </h2>
      <p class="text-[18px] leading-[1.5] max-w-[600px] mx-auto text-white/80">
        Pick. Pack. Send. The app does the file wizardry. You just send the cursed image.
      </p>
    </div>

    <div class="steps">
      <!-- 01 — Pick -->
      <div class="step">
        <div class="step-num">01</div>
        <h3 class="step-title">Pick the emotes</h3>
        <p class="step-desc">Browse trending, daily, weekly drops. Tap + on anything that captures the energy of your group chat.</p>
        <div class="step-art art1">
          <div class="mini sel" style="background:#f6c8d8;"><img class="em" src="/assets/emotes/KEKW.avif" alt="KEKW" loading="lazy"/></div>
          <div class="mini"     style="background:#fbe9c4;"><img class="em" src="/assets/emotes/Nerd.avif" alt="Nerd" loading="lazy"/></div>
          <div class="mini sel" style="background:#fff2b3;"><img class="em" src="/assets/emotes/PartyKirby.avif" alt="PartyKirby" loading="lazy"/></div>
          <div class="mini sel" style="background:#c9e8d4;"><img class="em" src="/assets/emotes/peepoComfy.avif" alt="peepoComfy" loading="lazy"/></div>
          <div class="mini"     style="background:#d6c8f6;"><img class="em" src="/assets/emotes/RIPBOZO.avif" alt="RIPBOZO" loading="lazy"/></div>
          <div class="mini sel" style="background:#ffd6c2;"><img class="em" src="/assets/emotes/classic.avif" alt="classic" loading="lazy"/></div>
        </div>
      </div>

      <!-- 02 — Pack -->
      <div class="step">
        <div class="step-num">02</div>
        <h3 class="step-title">Stack a pack</h3>
        <p class="step-desc">Bundle picks into themed packs — "gym chat", "doom posting", "family group cope". Tap "Add to WhatsApp" when ready.</p>
        <div class="step-art art2">
          <div class="pack-card">
            <div class="pack-ico" style="background:#f6c8d8;">
              <img class="em" src="/assets/emotes/KEKW.avif" alt="KEKW" loading="lazy"/>
            </div>
            <div class="flex-1">
              <div class="pack-t">cope arsenal</div>
              <div class="pack-s">6 stickers · ready to ship</div>
            </div>
            <div class="check">✓</div>
          </div>
          <div class="pack-card">
            <div class="pack-ico" style="background:#c9e8d4;">
              <img class="em" src="/assets/emotes/peepoComfy.avif" alt="peepoComfy" loading="lazy"/>
            </div>
            <div class="flex-1">
              <div class="pack-t">gym chat</div>
              <div class="pack-s">12 stickers · daily use</div>
            </div>
            <div class="check">✓</div>
          </div>
        </div>
      </div>

      <!-- 03 — Send -->
      <div class="step">
        <div class="step-num">03</div>
        <h3 class="step-title">Send. Stay seated.</h3>
        <p class="step-desc">Open WhatsApp, hit the sticker tray, fire away. The chat will be ruined. You're welcome.</p>
        <div class="step-art art3">
          <div class="bubble">they need to chill omg</div>
          <div class="bubble-time">16:09 ✓✓</div>
          <div class="sticker-msg" style="background:#f6c8d8;">
            <img class="em" src="/assets/emotes/KEKW.avif" alt="KEKW" loading="lazy"/>
          </div>
          <div class="bubble-time">16:09 ✓✓</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .head-eye {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, .08);
    border: 1px solid rgba(255, 255, 255, .18);
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    margin-bottom: 18px;
    color: var(--color-acid);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
  }
  @media (max-width: 900px) { .steps { grid-template-columns: 1fr; } }

  .step {
    background: rgba(255, 255, 255, .05);
    border: 1px solid rgba(255, 255, 255, .12);
    backdrop-filter: blur(20px);
    border-radius: 28px;
    padding: 30px 28px;
    position: relative;
    overflow: hidden;
  }
  /* Soft hotspot glow tucked into the top-right of each card. */
  .step::before {
    content: "";
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(255, 61, 242, .25), transparent 70%);
    pointer-events: none;
  }
  .step-num {
    display: inline-block;
    font-family: var(--font-shade);
    font-size: 56px;
    line-height: 1;
    color: var(--color-acid);
    margin-bottom: 14px;
  }
  .step-title {
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 1;
    margin: 0 0 12px;
    color: white;
  }
  .step-desc {
    color: rgba(255, 255, 255, .75);
    font-size: 15px;
    line-height: 1.55;
  }
  .step-art {
    margin-top: 20px;
    height: 220px;
    border-radius: 18px;
    background: rgba(0, 0, 0, .3);
    border: 1px solid rgba(255, 255, 255, .06);
    position: relative;
    overflow: hidden;
  }

  /* step 1 — mini grid of sticker thumbs, selected ones get acid ring + check */
  .art1 {
    padding: 14px;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 10px;
  }
  .mini {
    border-radius: 12px;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    font-size: 28px;
    position: relative;
  }
  .mini.sel {
    box-shadow: 0 0 0 3px var(--color-acid), 0 0 20px var(--color-acid);
  }
  .mini.sel::after {
    content: "";
    position: absolute;
    top: -8px;
    right: -8px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-acid);
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2315082b' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><polyline points='20 6 9 17 4 12'/></svg>");
    background-size: 60% 60%;
    background-repeat: no-repeat;
    background-position: center;
  }

  /* step 2 — list of pack cards (icon + title + check) */
  .art2 {
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pack-card {
    background: rgba(255, 255, 255, .08);
    border: 1px solid rgba(255, 255, 255, .14);
    border-radius: 14px;
    padding: 12px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .pack-ico {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    font-size: 22px;
  }
  .pack-t {
    font-family: var(--font-display);
    font-size: 13px;
    color: white;
  }
  .pack-s {
    font-size: 10px;
    color: rgba(255, 255, 255, .6);
    margin-top: 2px;
  }
  .check {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--color-acid);
    color: var(--color-ink);
    display: grid;
    place-items: center;
    font-weight: 800;
  }

  /* step 3 — fake WhatsApp chat: tan paper bg, green bubble, big sticker */
  .art3 {
    padding: 14px;
    background: #ece3d3;
  }
  .bubble {
    background: #d9fdd3;
    border-radius: 12px;
    padding: 8px 10px;
    font-size: 11px;
    color: #222;
    max-width: 70%;
    margin-left: auto;
    margin-bottom: 8px;
  }
  .bubble-time {
    font-size: 9px;
    color: #666;
    text-align: right;
    margin-top: 4px;
  }
  .sticker-msg {
    margin-left: auto;
    width: 100px;
    height: 100px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    font-size: 56px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, .15);
  }
</style>
